{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Test collection for the Hotel Offer Orchestrator API.\n\nCovers: city search, price filtering, no-results, supplier health, and mock supplier endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Search hotels in Delhi (overlapping suppliers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" }
              ]
            },
            "description": "Returns deduplicated hotels for Delhi. Supplier A and B overlap on Holtin, Taj Palace, ITC Grand, The Oberoi — the cheapest offer per hotel is returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each hotel has required fields', function () {",
                  "  pm.response.json().forEach(function(h) {",
                  "    pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "  });",
                  "});",
                  "",
                  "pm.test('Holtin should come from Supplier B (cheaper)', function () {",
                  "  var holtin = pm.response.json().find(h => h.name === 'Holtin');",
                  "  if (holtin) {",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "    pm.expect(holtin.price).to.eql(5340);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Search hotels in Mumbai",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "mumbai" }
              ]
            },
            "description": "Returns deduplicated hotels for Mumbai."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Filter hotels by price range (5000–8000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=8000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "5000" },
                { "key": "maxPrice", "value": "8000" }
              ]
            },
            "description": "Returns only Delhi hotels with price between 5000 and 8000. Filtering is performed inside Redis using ZRANGEBYSCORE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All prices within range', function () {",
                  "  pm.response.json().forEach(function(h) {",
                  "    pm.expect(h.price).to.be.at.least(5000);",
                  "    pm.expect(h.price).to.be.at.most(8000);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "City with no results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=atlantis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "atlantis" }
              ]
            },
            "description": "Returns an empty array for a city not in any supplier dataset."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is empty array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Missing city parameter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            },
            "description": "Returns 400 when the required 'city' query parameter is missing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message present', function () {",
                  "  pm.expect(pm.response.json().error).to.include('city');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns health status of the server, both suppliers, Redis, and Temporal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 503', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "pm.test('Has expected check keys', function () {",
                  "  var checks = pm.response.json().checks;",
                  "  pm.expect(checks).to.have.all.keys('server', 'supplierA', 'supplierB', 'redis', 'temporal');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
